      <geom name="ring_04" type="capsule" fromto="0 0.550000 0 -0.275000 0.476314 0" size="0.020" friction="0.5 0.005 0.0005" condim="6" solref="0.015 1" rgba="0.18 0.64 0.39 1"/>
