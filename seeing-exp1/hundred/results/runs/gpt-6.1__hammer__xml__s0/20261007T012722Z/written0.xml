<mujoco model="gravity_chain_reaction">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="80" cone="elliptic"/>
  <size njmax="2000" nconmax="300"/>
  <visual>
    <global azimuth="135" elevation="-22"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
  </visual>

  <worldbody>
    <light name="overhead" pos="0.5 -1.5 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <camera name="overview" pos="3.2 -4.6 2.8" xyaxes="0.84 0.54 0 -0.23 0.36 0.91"/>

    <geom name="floor" type="plane" pos="0 0 0" size="4 3 0.1" friction="0.9 0.01 0.02" condim="6" priority="1" rgba="0.22 0.25 0.28 1"/>

    <!-- The ball's starting contact point is 0.800 m along the ramp from its lower end. -->
    <body name="ramp" pos="-0.5287201 -0.5834576 0.7818402" euler="-0.35 0 0">
      <geom name="ramp_surface" type="box" size="0.15 0.525 0.03" friction="0.65 0.003 0.0001" condim="6" priority="2" rgba="0.55 0.38 0.20 1"/>
      <geom name="ramp_left_rail" type="capsule" fromto="-0.15 -0.525 0.055 -0.15 0.525 0.055" size="0.014" friction="0.4 0.003 0.0001" rgba="0.75 0.59 0.34 1"/>
      <geom name="ramp_right_rail" type="capsule" fromto="0.15 -0.525 0.055 0.15 0.525 0.055" size="0.014" friction="0.4 0.003 0.0001" rgba="0.75 0.59 0.34 1"/>
    </body>

    <body name="ball" pos="-0.5287201 -0.8092068 0.9653775">
      <freejoint name="ball_free"/>
      <geom name="ball_sphere" type="sphere" size="0.065" mass="0.4" friction="0.65 0.005 0.0001" condim="6" solref="0.006 1" rgba="0.95 0.18 0.10 1"/>
    </body>

    <!-- The ball pushes this support sideways, perpendicular to the hammer's swing. -->
    <body name="prop" pos="-0.5287201 0 0.4169060">
      <joint name="prop_slide" type="slide" axis="0 1 0" range="0 0.45" damping="0.035" frictionloss="0.01"/>
      <geom name="prop_support" type="box" size="0.085 0.035 0.4" mass="0.1" friction="0.025 0.001 0.0001" priority="3" solref="0.004 1" rgba="0.25 0.75 0.35 1"/>
    </body>

    <body name="prop_track" pos="-0.5287201 0.225 0.006">
      <geom name="prop_track_base" type="box" size="0.11 0.29 0.006" rgba="0.35 0.38 0.40 1"/>
    </body>

    <body name="hammer_mount" pos="0 0 0">
      <geom name="hammer_mount_column" type="box" pos="0 0.25 0.65" size="0.055 0.055 0.65" rgba="0.32 0.35 0.39 1"/>
      <geom name="hammer_mount_axle" type="cylinder" pos="0 0.1 1.3" euler="1.5707963 0 0" size="0.055 0.20" contype="0" conaffinity="0" rgba="0.65 0.68 0.72 1"/>
    </body>

    <!-- Initially the spherical head rests on the prop. Gravity supplies the swing. -->
    <body name="hammer" pos="0 0 1.3" euler="0 0.95 0">
      <joint name="hammer_hinge" type="hinge" axis="0 1 0" range="-2.2 0.025" damping="0.025" frictionloss="0.002"/>
      <geom name="hammer_arm" type="capsule" fromto="0 0 0 0 0 -0.65" size="0.022" mass="0.04" friction="0.15 0.002 0.0001" rgba="0.62 0.65 0.69 1"/>
      <geom name="hammer_head" type="sphere" pos="0 0 -0.65" size="0.105" mass="0.95" friction="0.12 0.002 0.0001" solref="0.004 1" rgba="0.22 0.24 0.28 1"/>
    </body>

    <!-- The striker initially ends at x=0.50; the payload begins at x=0.715. -->
    <body name="peg" pos="0.325 0 0.65">
      <joint name="peg_slide" type="slide" axis="1 0 0" range="0 0.65" damping="0.03" frictionloss="0.008"/>
      <geom name="peg_striker" type="cylinder" quat="0.70710678 0 0.70710678 0" size="0.055 0.175" mass="0.4" friction="0.15 0.002 0.0001" solref="0.004 1" rgba="0.90 0.63 0.12 1"/>
    </body>

    <!-- Non-colliding bearing covers visualize the ideal slide-joint guide. -->
    <body name="peg_guide" pos="0.325 0 0.65">
      <geom name="peg_guide_left" type="box" pos="0 -0.085 0" size="0.10 0.02 0.085" contype="0" conaffinity="0" rgba="0.36 0.40 0.44 1"/>
      <geom name="peg_guide_right" type="box" pos="0 0.085 0" size="0.10 0.02 0.085" contype="0" conaffinity="0" rgba="0.36 0.40 0.44 1"/>
      <geom name="peg_guide_bottom" type="box" pos="0 0 -0.085" size="0.10 0.065 0.02" contype="0" conaffinity="0" rgba="0.36 0.40 0.44 1"/>
    </body>

    <body name="block_stand" pos="0.79 0 0.2925">
      <geom name="block_stand_platform" type="box" size="0.09 0.13 0.2925" friction="0.18 0.003 0.0001" priority="1" rgba="0.43 0.46 0.50 1"/>
    </body>

    <body name="block" pos="0.78 0 0.65">
      <freejoint name="block_free"/>
      <geom name="block_payload" type="box" size="0.065 0.065 0.065" mass="0.14" friction="0.35 0.005 0.001" condim="6" solref="0.006 1" rgba="0.25 0.48 0.95 1"/>
    </body>

    <!-- A horizontal rectangular hoop lies below the payload's departure height. -->
    <body name="hoop" pos="0 0 0.385">
      <geom name="hoop_near" type="capsule" fromto="0.90 -0.335 0 2.13 -0.335 0" size="0.016" rgba="0.98 0.80 0.15 1"/>
      <geom name="hoop_far" type="capsule" fromto="0.90 0.335 0 2.13 0.335 0" size="0.016" rgba="0.98 0.80 0.15 1"/>
      <geom name="hoop_left" type="capsule" fromto="0.90 -0.335 0 0.90 0.335 0" size="0.016" rgba="0.98 0.80 0.15 1"/>
      <geom name="hoop_right" type="capsule" fromto="2.13 -0.335 0 2.13 0.335 0" size="0.016" rgba="0.98 0.80 0.15 1"/>
    </body>

    <!-- The far wall is taller to retain a payload with excess horizontal speed. -->
    <body name="cup" pos="0 0 0">
      <geom name="cup_bottom" type="box" pos="1.515 0 0.0175" size="0.65 0.37 0.0175" friction="0.85 0.01 0.01" condim="6" priority="2" solref="0.008 1" rgba="0.18 0.58 0.65 1"/>
      <geom name="cup_left_wall" type="box" pos="0.88 0 0.15" size="0.035 0.37 0.115" friction="0.85 0.01 0.01" condim="6" priority="2" rgba="0.18 0.58 0.65 0.55"/>
      <geom name="cup_right_wall" type="box" pos="2.15 0 0.3425" size="0.035 0.37 0.3075" friction="0.85 0.01 0.01" condim="6" priority="2" rgba="0.18 0.58 0.65 0.55"/>
      <geom name="cup_near_wall" type="box" pos="1.515 -0.335 0.15" size="0.60 0.035 0.115" friction="0.85 0.01 0.01" condim="6" priority="2" rgba="0.18 0.58 0.65 0.45"/>
      <geom name="cup_far_wall" type="box" pos="1.515 0.335 0.15" size="0.60 0.035 0.115" friction="0.85 0.01 0.01" condim="6" priority="2" rgba="0.18 0.58 0.65 0.55"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="start" time="0" qpos="-0.5287201 -0.8092068 0.9653775 1 0 0 0 0 0 0 0.78 0 0.65 1 0 0 0"/>
  </keyframe>
</mujoco>
