<mujoco model="gravity_triggered_slider_release">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" iterations="100"/>
  <size njmax="2000" nconmax="400"/>
  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
  </visual>

  <worldbody>
    <light name="overhead_light" pos="-1 -2 4" dir="0.2 0.4 -1"/>
    <camera name="overview" pos="2.4 -3.4 2.3" xyaxes="0.817 0.577 0 -0.250 0.354 0.901"/>
    <geom name="floor" type="plane" size="4 4 0.1" rgba="0.82 0.84 0.87 1" friction="0.8 0.01 0.001"/>

    <!-- Four narrow guide rods constrain the ball without obstructing the moving ramp. -->
    <body name="ball_guide">
      <geom name="ball_guide_1" type="capsule" fromto="-0.76 -0.66 0.75 -0.76 -0.66 1.90" size="0.014" rgba="0.25 0.29 0.34 1" friction="0.02 0.001 0.0001"/>
      <geom name="ball_guide_2" type="capsule" fromto="-0.76 -0.54 0.75 -0.76 -0.54 1.90" size="0.014" rgba="0.25 0.29 0.34 1" friction="0.02 0.001 0.0001"/>
      <geom name="ball_guide_3" type="capsule" fromto="-0.64 -0.66 0.75 -0.64 -0.66 1.90" size="0.014" rgba="0.25 0.29 0.34 1" friction="0.02 0.001 0.0001"/>
      <geom name="ball_guide_4" type="capsule" fromto="-0.64 -0.54 0.75 -0.64 -0.54 1.90" size="0.014" rgba="0.25 0.29 0.34 1" friction="0.02 0.001 0.0001"/>
    </body>

    <!-- The initial sphere center is 0.400 m above its first ramp-contact height. -->
    <body name="ball" pos="-0.70 -0.60 1.7343503">
      <freejoint name="ball_free"/>
      <geom name="ball_sphere" type="sphere" size="0.07" mass="2.0" rgba="1 0.55 0.08 1" friction="0.02 0.001 0.0001" solref="0.012 1"/>
    </body>

    <!-- A descending ball drives this 45-degree ramp in the positive x direction. -->
    <body name="slider1" pos="-0.70 -0.60 1.20">
      <joint name="slider1_slide" type="slide" axis="1 0 0" range="0 0.44" damping="1.0" frictionloss="0.03" solreflimit="0.012 1"/>
      <geom name="slider1_ramp" type="box" pos="-0.15 0 -0.15" quat="0.923879533 0 -0.382683432 0" size="0.50 0.032 0.025" mass="0.35" rgba="0.85 0.20 0.15 1" friction="0.02 0.001 0.0001" solref="0.012 1"/>
      <geom name="slider1_lower_arm" type="box" pos="-0.09 0 -0.50" size="0.41 0.020 0.019" mass="0.15" rgba="0.70 0.15 0.12 1" friction="0.02 0.001 0.0001"/>
      <geom name="slider1_ramp_brace" type="box" pos="0.15 0 -0.16" size="0.015 0.022 0.34" mass="0.05" rgba="0.70 0.15 0.12 1" friction="0.02 0.001 0.0001"/>
      <geom name="slider1_pusher" type="sphere" pos="0.32 0 -0.50" size="0.035" mass="0.05" rgba="0.95 0.30 0.18 1" friction="0.02 0.001 0.0001" solref="0.012 1"/>
    </body>

    <!-- The pusher first crosses a roughly 0.11 m gap, then engages this diagonal cam. -->
    <!-- Cam contact converts positive-x motion into positive-y support withdrawal. -->
    <body name="slider2" pos="0 0 1.00">
      <joint name="slider2_slide" type="slide" axis="0 1 0" range="0 0.36" damping="1.0" frictionloss="0.03" solreflimit="0.012 1"/>
      <geom name="slider2_cam" type="box" pos="-0.20 -0.60 -0.30" quat="0.923879533 0 0 -0.382683432" size="0.58 0.025 0.035" mass="0.20" rgba="0.15 0.40 0.85 1" friction="0.02 0.001 0.0001" solref="0.012 1"/>
      <geom name="slider2_cam_connector" type="box" pos="-0.215 -0.60 -0.30" size="0.040 0.025 0.025" mass="0.04" rgba="0.12 0.30 0.70 1" friction="0.02 0.001 0.0001"/>
      <geom name="slider2_side_beam" type="box" pos="-0.23 -0.30 -0.30" size="0.025 0.30 0.025" mass="0.08" rgba="0.12 0.30 0.70 1" friction="0.02 0.001 0.0001"/>
      <geom name="slider2_support_riser" type="box" pos="-0.23 0 -0.15" size="0.025 0.035 0.15" mass="0.08" rgba="0.12 0.30 0.70 1" friction="0.02 0.001 0.0001"/>
      <geom name="slider2_support_arm" type="box" pos="-0.115 0 -0.018" size="0.14 0.080 0.018" mass="0.08" rgba="0.15 0.40 0.85 1" friction="0.015 0.001 0.0001"/>
      <geom name="slider2_support_pad" type="box" pos="0 0 -0.018" size="0.11 0.080 0.018" mass="0.12" rgba="0.20 0.50 0.95 1" friction="0.015 0.001 0.0001" solref="0.012 1"/>
    </body>

    <body name="block" pos="0 0 1.065">
      <freejoint name="block_free"/>
      <geom name="block_cube" type="box" size="0.065 0.065 0.065" mass="0.30" rgba="0.20 0.75 0.35 1" friction="0.015 0.001 0.0001" solref="0.012 1"/>
    </body>

    <body name="hoop" pos="0 0 0.60">
      <geom name="hoop_ring_01" type="capsule" fromto="0.240000 0 0 0.207846 0.120000 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_02" type="capsule" fromto="0.207846 0.120000 0 0.120000 0.207846 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_03" type="capsule" fromto="0.120000 0.207846 0 0 0.240000 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_04" type="capsule" fromto="0 0.240000 0 -0.120000 0.207846 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_05" type="capsule" fromto="-0.120000 0.207846 0 -0.207846 0.120000 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_06" type="capsule" fromto="-0.207846 0.120000 0 -0.240000 0 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_07" type="capsule" fromto="-0.240000 0 0 -0.207846 -0.120000 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_08" type="capsule" fromto="-0.207846 -0.120000 0 -0.120000 -0.207846 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_09" type="capsule" fromto="-0.120000 -0.207846 0 0 -0.240000 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_10" type="capsule" fromto="0 -0.240000 0 0.120000 -0.207846 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_11" type="capsule" fromto="0.120000 -0.207846 0 0.207846 -0.120000 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_ring_12" type="capsule" fromto="0.207846 -0.120000 0 0.240000 0 0" size="0.012" rgba="0.95 0.75 0.12 1" friction="0.2 0.005 0.0001"/>
      <geom name="hoop_left_post" type="capsule" fromto="-0.38 0 -0.585 -0.38 0 0" size="0.015" rgba="0.40 0.43 0.47 1"/>
      <geom name="hoop_right_post" type="capsule" fromto="0.38 0 -0.585 0.38 0 0" size="0.015" rgba="0.40 0.43 0.47 1"/>
      <geom name="hoop_left_brace" type="capsule" fromto="-0.38 0 0 -0.24 0 0" size="0.012" rgba="0.40 0.43 0.47 1"/>
      <geom name="hoop_right_brace" type="capsule" fromto="0.24 0 0 0.38 0 0" size="0.012" rgba="0.40 0.43 0.47 1"/>
    </body>

    <body name="box">
      <geom name="box_bottom" type="box" pos="0 0 0.04" size="0.34 0.34 0.04" rgba="0.45 0.50 0.58 1" friction="0.7 0.01 0.001" solref="0.015 1"/>
      <geom name="box_left_wall" type="box" pos="-0.32 0 0.20" size="0.02 0.34 0.12" rgba="0.50 0.56 0.64 1" friction="0.7 0.01 0.001"/>
      <geom name="box_right_wall" type="box" pos="0.32 0 0.20" size="0.02 0.34 0.12" rgba="0.50 0.56 0.64 1" friction="0.7 0.01 0.001"/>
      <geom name="box_front_wall" type="box" pos="0 -0.32 0.20" size="0.30 0.02 0.12" rgba="0.50 0.56 0.64 1" friction="0.7 0.01 0.001"/>
      <geom name="box_back_wall" type="box" pos="0 0.32 0.20" size="0.30 0.02 0.12" rgba="0.50 0.56 0.64 1" friction="0.7 0.01 0.001"/>
    </body>
  </worldbody>
</mujoco>
