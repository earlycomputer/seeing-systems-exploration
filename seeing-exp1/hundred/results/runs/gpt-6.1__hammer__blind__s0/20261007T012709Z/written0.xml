    </body>

    <!-- The support withdraws sideways, perpendicular to the hammer's swing. -->
    <body name="prop" pos="-0.65 0 1.17">
      <joint name="prop_slide" type="slide" axis="0 1 0" limited="true" range="0 0.50" damping="0.03" frictionloss="0.03"/>
