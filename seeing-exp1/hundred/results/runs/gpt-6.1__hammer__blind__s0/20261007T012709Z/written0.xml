    <!-- The ball starts approximately 0.8 m uphill from the prop. -->
    <body name="ramp" pos="-0.81 -0.66 1.229" quat="0.992546 -0.121869 0 0">
      <geom name="ramp_deck" type="box" size="0.10 0.55 0.025" rgba="0.55 0.60 0.65 1" priority="1" condim="3" friction="0.5 0.005 0.0001" solref="0.008 1"/>
