      <geom name="cup_left_wall" type="box" pos="-0.575 0 0.245" size="0.025 0.60 0.155" rgba="0.15 0.55 0.65 1" priority="1" condim="6" friction="0.9 0.03 0.02" solref="0.01 1"/>
      <geom name="cup_right_wall" type="box" pos="0.575 0 0.245" size="0.025 0.60 0.155" rgba="0.15 0.55 0.65 1" priority="1" condim="6" friction="0.9 0.03 0.02" solref="0.01 1"/>
