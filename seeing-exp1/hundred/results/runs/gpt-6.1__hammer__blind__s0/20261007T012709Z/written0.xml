      <geom name="hoop_segment_09" type="capsule" fromto="-0.4900 0 0 -0.4527 -0.1875 0" size="0.018" rgba="0.95 0.65 0.10 1"/>
      <geom name="hoop_segment_10" type="capsule" fromto="-0.4527 -0.1875 0 -0.3465 -0.3465 0" size="0.018" rgba="0.95 0.65 0.10 1"/>
      <geom name="hoop_segment_11" type="capsule" fromto="-0.3465 -0.3465 0 -0.1875 -0.4527 0" size="0.018" rgba="0.95 0.65 0.10 1"/>
      <geom name="hoop_segment_12" type="capsule" fromto="-0.1875 -0.4527 0 0 -0.4900 0" size="0.018" rgba="0.95 0.65 0.10 1"/>
      <geom name="hoop_segment_13" type="capsule" fromto="0 -0.4900 0 0.1875 -0.4527 0" size="0.018" rgba="0.95 0.65 0.10 1"/>
