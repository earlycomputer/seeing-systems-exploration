<mujoco model="trigger_wedge_cart_drop">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="80"/>
  <size njmax="1000" nconmax="300"/>
  <statistic center="1.0 0 1.2" extent="3.6"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
  </visual>

  <worldbody>
    <light name="main_light" pos="0 -3 5" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.22 0.25 0.28 1" friction="0.8 0.02 0.01" condim="6"/>

    <!-- The trigger's bottom starts exactly 0.5 m above the wedge cap. -->
    <body name="trigger" pos="0.35 0 2.75">
      <freejoint name="trigger_free"/>
      <geom name="trigger_ball" type="sphere" size="0.10" mass="5" rgba="0.9 0.25 0.12 1" friction="0.6 0.01 0.005" condim="6" solref="0.012 1"/>
    </body>

    <!-- Static joint friction holds the wedge until the trigger arrives. -->
    <!-- The inclined face rises toward +x, so descending motion drives the follower toward +x. -->
    <body name="wedge" pos="0 0 1.4">
      <joint name="wedge_slide" type="slide" axis="0 0 -1" limited="true" range="0 0.51" frictionloss="15" damping="4"/>
      <geom name="wedge_incline" type="box" size="0.95 0.12 0.025" quat="0.923879533 0 -0.382683432 0" mass="0.75" rgba="0.95 0.65 0.12 1" friction="0.025 0.001 0.001" condim="3" solref="0.012 1"/>
      <geom name="wedge_cap" type="box" pos="0.35 0 0.715" size="0.45 0.24 0.035" mass="0.25" rgba="0.95 0.65 0.12 1" friction="0.6 0.01 0.005" condim="6" solref="0.012 1"/>
    </body>

    <body name="cart" pos="0 0 1.15">
      <joint name="cart_slide" type="slide" axis="1 0 0" limited="true" range="0 0.40" damping="60"/>
      <geom name="cart_follower" type="sphere" size="0.07" mass="0.6" rgba="0.15 0.55 0.9 1" friction="0.025 0.001 0.001" condim="3" solref="0.012 1"/>
      <geom name="cart_striker" type="box" pos="0.43 0 -0.12" size="0.43 0.06 0.06" mass="2.4" rgba="0.15 0.55 0.9 1" friction="0.5 0.01 0.005" condim="6" solref="0.012 1"/>
    </body>

    <body name="block" pos="0.96 0 1.03">
      <freejoint name="block_free"/>
      <geom name="block_payload" type="sphere" size="0.08" mass="0.25" rgba="0.3 0.85 0.35 1" friction="0.8 0.02 0.01" condim="6" solref="0.012 1"/>
    </body>

    <body name="ledge" pos="0.775 0 0.9">
      <geom name="ledge_top" type="box" size="0.225 0.18 0.05" rgba="0.55 0.48 0.38 1" friction="0.5 0.01 0.003" condim="6" solref="0.012 1"/>
      <geom name="ledge_support" type="box" pos="-0.155 0 -0.475" size="0.045 0.16 0.425" rgba="0.45 0.39 0.31 1"/>
    </body>

    <!-- A horizontal ring assembled entirely from primitive capsules. -->
    <body name="hoop" pos="1.60 0 0.62">
      <geom name="hoop_00" type="capsule" fromto="0.72 0 0 0.665193 0.275532 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_01" type="capsule" fromto="0.665193 0.275532 0 0.509117 0.509117 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_02" type="capsule" fromto="0.509117 0.509117 0 0.275532 0.665193 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_03" type="capsule" fromto="0.275532 0.665193 0 0 0.72 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_04" type="capsule" fromto="0 0.72 0 -0.275532 0.665193 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_05" type="capsule" fromto="-0.275532 0.665193 0 -0.509117 0.509117 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_06" type="capsule" fromto="-0.509117 0.509117 0 -0.665193 0.275532 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_07" type="capsule" fromto="-0.665193 0.275532 0 -0.72 0 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_08" type="capsule" fromto="-0.72 0 0 -0.665193 -0.275532 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_09" type="capsule" fromto="-0.665193 -0.275532 0 -0.509117 -0.509117 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_10" type="capsule" fromto="-0.509117 -0.509117 0 -0.275532 -0.665193 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_11" type="capsule" fromto="-0.275532 -0.665193 0 0 -0.72 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_12" type="capsule" fromto="0 -0.72 0 0.275532 -0.665193 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_13" type="capsule" fromto="0.275532 -0.665193 0 0.509117 -0.509117 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_14" type="capsule" fromto="0.509117 -0.509117 0 0.665193 -0.275532 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
      <geom name="hoop_15" type="capsule" fromto="0.665193 -0.275532 0 0.72 0 0" size="0.018" rgba="0.9 0.3 0.65 1"/>
    </body>

    <body name="box" pos="1.65 0 0">
      <geom name="box_bottom" type="box" pos="0 0 0.04" size="1.10 0.825 0.04" rgba="0.25 0.6 0.65 1" friction="0.8 0.02 0.01" condim="6" solref="0.015 1"/>
      <geom name="box_left" type="box" pos="-1.075 0 0.22" size="0.025 0.825 0.14" rgba="0.25 0.6 0.65 1" friction="0.8 0.02 0.01" condim="6" solref="0.015 1"/>
      <geom name="box_right" type="box" pos="1.075 0 0.22" size="0.025 0.825 0.14" rgba="0.25 0.6 0.65 1" friction="0.8 0.02 0.01" condim="6" solref="0.015 1"/>
      <geom name="box_front" type="box" pos="0 -0.8 0.22" size="1.05 0.025 0.14" rgba="0.25 0.6 0.65 0.45" friction="0.8 0.02 0.01" condim="6" solref="0.015 1"/>
      <geom name="box_back" type="box" pos="0 0.8 0.22" size="1.05 0.025 0.14" rgba="0.25 0.6 0.65 1" friction="0.8 0.02 0.01" condim="6" solref="0.015 1"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="start"/>
  </keyframe>
</mujoco>
