world  passive ramp domino and lever cascade

-- MuJoCo's standard gravity is 9.81 m/s².
-- All bodies start with zero velocity.
-- Dead contacts approximate, but do not specify, restitution 0.05.
-- Cart guides approximate a horizontal slide, without linear damping.
-- Springs store the energy needed to overcome the cart's contact friction.
-- The domino-operated latch keeps the striking flap stationary initially.

floor
  size      8 m
  friction  0.70, spinning 0, rolling 0

-- Ramp endpoints lie on the deck's midplane.
-- These heights put its lower upper surface at 0.15 m.
-- Endpoint separation is 1.00 m, inclined at 20 degrees.

ramp1 high
  is a  point
  at    0.939693 m behind floor, 0.11 m to the left, 0.473226 m up

ramp1 low
  is a  point
  at    0 m along, 0.11 m to the left, 0.131206 m up

ramp1
  is a      plank from ramp1 high to ramp1 low, 0.30 m wide, 0.04 m thick
  friction  0.70, spinning 0, rolling 0
  bounce    dead

ball1
  is a      sphere 0.10 m across, 0.20 kg
  rolls
  friction  0.70, spinning 0, rolling 0
  bounce    dead
  moves     freely
  at        0.915751 m behind ramp1 low, 0.11 m to the left, 0.539005 m up

-- The first domino's near face is 0.10 m beyond the deck's exit.
-- Domino centre spacing is 0.18 m.

domino1
  is a      box 0.08 by 0.04 by 0.24 m, 0.25 kg
  friction  0.70, spinning 0, rolling 0
  bounce    dead
  moves     freely
  stands    on floor, 0.146840 m along, 0.11 m to the left

domino2
  is a      box 0.08 by 0.04 by 0.24 m, 0.25 kg
  friction  0.70, spinning 0, rolling 0
  bounce    dead
  moves     freely
  stands    on floor, 0.18 m beyond domino1, 0.11 m to the left

-- Upright panel: 0.40 m tall, 0.20 m wide, 0.04 m thick.
-- Its bottom hinge is 0.10 m above the floor.
-- Positive rotation tips the panel forward toward the cart.

flap1
  is a           box 0.04 by 0.20 by 0.40 m, 0.30 kg
  friction       0.70, spinning 0, rolling 0
  bounce         dead
  at             0.18 m beyond domino2, 0 m to the left, 0.30 m up
  turns on       flap hinge, about y, at its bottom
  swings         from 0° to 65°
  spring         5 N·m/rad toward 65°
  damping        0.04 N·m·s/rad
  starts turned  0°

-- Lightweight rigid links connect the flap to its latch.
-- They run outside the domino path.

flap latch upper link
  is a         box 0.04 by 0.12 by 0.004 m, 0.001 kg
  friction     0.70, spinning 0, rolling 0
  bounce       dead
  at           0.506840 m along, 0.14 m to the left, 0.30 m up
  attached to  flap1

flap latch upright
  is a         box 0.012 by 0.012 by 0.12 m, 0.001 kg
  friction     0.70, spinning 0, rolling 0
  bounce       dead
  at           0.506840 m along, 0.19 m to the left, 0.24 m up
  attached to  flap1

flap latch nose
  is a         box 0.20 by 0.012 by 0.003 m, 0.001 kg
  friction     0.70, spinning 0, rolling 0
  bounce       dead
  at           0.606840 m along, 0.19 m to the left, 0.18 m up
  attached to  flap1

-- Domino2 depresses the long rear end of this release bar.
-- The flap load acts near the bar's pivot, reducing release effort.

