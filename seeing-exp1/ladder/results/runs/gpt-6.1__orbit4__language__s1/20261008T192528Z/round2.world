world  revised high leverage domino chain

floor
  size      8 m
  friction  0.68

-- All moving bodies start from rest.
-- Gravity relies on MuJoCo's default 9.81 m/s2.
-- Dead contacts do not specify exact restitution 0.05.

ramp1 high
  is a  point
  at    0 m along, 0 m to the left, 0.440379 m up

ramp1 low
  is a  point
  at    0.898243 m along, 0 m to the left, 0.131090 m up

-- Length 0.95 m, width 0.30 m, inclination 19 degrees.
-- The low-end upper surface is 0.15 m above the floor.
ramp1
  is a      plank from ramp1 high to ramp1 low, 0.30 m wide, 0.04 m thick
  friction  0.68
  bounce    dead
  colour    wood

ball1 launch perch
  is a      box 0.14 by 0.30 by 0.02 m
  at        -0.06 m along, 0 m to the left, 0.449289 m up
  friction  0.68
  bounce    dead
  colour    wood

ball1
  is a      sphere 0.10 m across, 0.20 kg
  moves     freely
  rolls
  at        -0.04 m along, 0 m to the left, 0.509289 m up
  friction  0.68
  bounce    dead
  colour    orange

pendulum1 pivot
  is a  point
  at    -0.10 m along, 0 m to the left, 1.049289 m up

pendulum1
  is a           box 0.02 by 0.02 by 0.55 m, 0.40 kg
  at             -0.10 m along, 0 m to the left, 0.774289 m up
  turns on       pendulum1 hinge, about y, at pendulum1 pivot
  swings         from -80° to 55°
  starts turned  55°
  damping        0.04 N·m·s/rad
  friction       0.68
  bounce         dead
  colour         grey

-- Approximate slide using a 100 m suspension radius.
-- Equivalent translational damping: 2000 / 100 squared = 0.20 N·s/m.
-- The cart rises approximately 0.8 mm during 0.40 m of travel.
-- This is not an exact prismatic joint.
cart1 guide pivot
  is a  point
  at    1.128243 m along, 0 m to the left, 100.20 m up

cart1
  is a           box 0.22 by 0.18 by 0.10 m, 0.50 kg
  at             1.128243 m along, 0 m to the left, 0.20 m up
  turns on       cart1 approximate slide, about y, at cart1 guide pivot
  swings         from -0.006000036 rad to 0 rad
  starts turned  0 rad
  damping        2000 N·m·s/rad
  friction       0.68
  bounce         dead
  colour         grey

-- Cart near face is 0.12 m beyond ramp1's low end.
-- Domino near face is 0.40 m beyond the cart's initial far face.
-- The domino retains its 0.08 by 0.04 by 0.24 m dimensions,
-- oriented with the 0.04 m dimension along the travel direction.
domino1
  is a      box 0.04 by 0.08 by 0.24 m, 0.25 kg
  moves     freely
  at        1.658243 m along, 0 m to the left, 0.12 m up
  friction  0.68
  bounce    dead
  colour    white

-- The upright flap's near face is 0.18 m beyond
-- the upright domino's far face.
-- Its lower edge is within reach of the falling domino.
flap1 pivot
  is a  point
  at    1.878243 m along, 0 m to the left, 0.14 m up

