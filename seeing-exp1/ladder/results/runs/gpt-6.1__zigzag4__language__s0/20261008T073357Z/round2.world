world  separated ring and cart lanes

floor
  size      6 m
  friction  0.72, spinning 0.005, rolling 0.002

lever pivot
  is a  point
  at    60 cm up, 0 cm along, 0 cm to the left

-- Beam and attached striker pieces total 0.50 kg.
lever1
  is a           box 60 by 10 by 4 cm, 489 g
  centred over lever pivot, level with lever pivot
  turns on       lever hinge, about y, at lever pivot
  swings         from -45° to 0°
  starts turned  0°
  damping        0.04 N·m·s/rad
  friction       0.72, spinning 0.005, rolling 0.002
  bounce         dead
  colour         wood

lever far end
  is a  point
  at    30 cm along, 0 cm to the left, 60 cm up

striker foot
  is a  point
  at    30 cm along, 25 cm to the right, 60 cm up

striker tip
  is a  point
  at    30 cm along, 25 cm to the right, 90 cm up

striker crossbar
  is a         rod 2 mm thick, from lever far end to striker foot
  weighs       1 g
  attached to  lever1
  friction     0.72, spinning 0.005, rolling 0.002
  bounce       dead
  colour       grey

cart striker
  is a         rod 1 cm thick, from striker foot to striker tip
  weighs       10 g
  attached to  lever1
  friction     0.72, spinning 0.005, rolling 0.002
  bounce       dead
  colour       grey

ring1
  is a      ring 16 cm across, 8 mm thick
  at        92 cm up, 30 cm behind lever pivot, 4 cm left of lever pivot
  friction  0.72, spinning 0.005, rolling 0.002
  bounce    dead
  colour    orange

ball1
  is a      sphere 10 cm across, 0.20 kg
  moves     freely
  rolls
  centred over ring1, 30 cm above ring1
  friction  0.72, spinning 0.005, rolling 0.002
  bounce    dead
  colour    white

-- The cart lane is laterally clear of the ring.
-- A distant hinge approximates horizontal translation.
-- Damping divided by radius squared is 0.20 N·s/m.
cart guide pivot
  is a  point
  at    1000.87 m up, 13 cm along, 25 cm to the right

cart1
  is a           box 22 by 18 by 10 cm, 0.50 kg
  centred over cart guide pivot, 1000 m below cart guide pivot
  turns on       cart guide, about y, at cart guide pivot
  swings         from -10° to 10°
  starts turned  0°
  damping        200000 N·m·s/rad
  friction       0.72, spinning 0.005, rolling 0.002
  bounce         dead
  colour         grey

domino support
  is a      box 8 by 4 by 82 cm
  on        floor, 44 cm behind lever pivot, 25 cm right of lever pivot
  friction  0.72, spinning 0.005, rolling 0.002
  bounce    dead
  colour    dark grey

-- Cart near face starts at x = 0.02 m.
-- Domino far face starts at x = -0.40 m.
-- Contact therefore requires 0.42 m of cart travel.
domino1
  is a      box 8 by 4 by 24 cm, 0.25 kg
  moves     freely
  on        domino support, centred over domino support
  friction  0.72, spinning 0.005, rolling 0.002
  bounce    dead
  colour    wood

expect
  ball1 drops through ring1
  ball1 touches lever1
  cart striker touches cart1
  lever1 reaches its lower stop
  cart1 touches domino1
