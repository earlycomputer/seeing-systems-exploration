world  balanced spring cart ramp pendulum and door

-- All moving bodies start from rest.
-- Gravity uses the compiler default; no gravity-setting syntax is supplied.
-- Numeric restitution cannot be specified; dead contacts are used.
-- The guided free cart approximates an axial slide joint.
-- Two mirrored torsional pushers approximate the axial spring.
-- Each pusher tip starts 0.20 m above its neutral height.
-- Their combined neutral-position equivalents are:
-- stiffness 18 N/m and damping 0.20 N s/m.
-- Those equivalents are local, not an exact linear spring and damper.

floor
  size      6 m
  friction  0.68, spinning 0, rolling 0

ramp high
  is a  point
  at    0 m along, 0 m to the left, 0.482623217 m up

ramp low
  is a  point
  at    0.939692621 m along, 0 m to the left, 0.140603074 m up

-- Length 1.00 m, width 0.30 m, inclination 20 degrees.
-- The low-end upper surface is 0.15 m above the floor.
ramp1
  is a      plank from ramp high to ramp low, 0.30 m wide, 0.02 m thick
  friction  0.68, spinning 0, rolling 0
  bounce    dead
  colour    wood

ball1
  is a      sphere 0.10 m across, 0.20 kg
  moves     freely
  rolls
  at        0.020521209 m along, 0 m to the left, 0.539004775 m up
  friction  0.68, spinning 0, rolling 0
  bounce    dead
  colour    orange

-- Initial retainer contact is intentional, not a new run event.
-- Gravity holds this retainer against its closed stop.
-- Once pushed past approximately 8.53 degrees, it falls to its open
-- stop and remains above the ball's rolling path.
ball retainer pivot
  is a  point
  at    0.140521209 m along, 0 m to the left, 0.139004775 m up

ball retainer
  is a           sphere 0.01 m radius, 0.51 kg
  at             0.080521209 m along, 0 m to the left, 0.539004775 m up
  turns on       ball retainer hinge, about y, at ball retainer pivot
  swings         from 0° to 29°
  damping        0.04 N·m·s/rad
  starts turned  0°
  friction       0.68, spinning 0, rolling 0
  bounce         dead
  colour         grey

-- The leading lower corner is behind and above the ball.
-- With the cart upright, first contact occurs after a 0.50 m drop.
-- This corner contact pushes forward rather than pinning the ball
-- beneath the middle of the cart.
cart1
  is a      box 0.22 by 0.18 by 0.10 m, 0.50 kg
  moves     freely
  at        -0.124478791 m along, 0 m to the left, 1.124711917 m up
  friction  0.68, spinning 0, rolling 0
  bounce    dead
  colour    grey

cart near guide
  is a      box 0.02 by 0.184 by 0.61 m
  at        -0.264478791 m along, 0 m to the left, 0.930 m up
  friction  0.68, spinning 0, rolling 0
  bounce    dead
  colour    dark grey

cart far guide
  is a      box 0.02 by 0.184 by 0.61 m
  at        0.015521209 m along, 0 m to the left, 0.930 m up
  friction  0.68, spinning 0, rolling 0
  bounce    dead
  colour    dark grey

cart left guide
  is a      box 0.26 by 0.018 by 0.61 m
  at        -0.124478791 m along, 0.101 m to the left, 0.930 m up
  friction  0.68, spinning 0, rolling 0
  bounce    dead
  colour    dark grey

cart right guide
  is a      box 0.26 by 0.018 by 0.61 m
  at        -0.124478791 m along, 0.101 m to the right, 0.930 m up
  friction  0.68, spinning 0, rolling 0
  bounce    dead
  colour    dark grey

-- Both pusher radii are sqrt(0.40) m.
-- Mirrored rotations balance the longitudinal forces and pitch torque.
-- Each arm has two symmetrically placed tips to balance roll and yaw.
-- The two tip pairs are staggered across so they do not overlap.
-- Only the tips collide; the arms pass through the fixed guides.

left pusher pivot
  is a  point
  at    -0.724478791 m along, 0 m to the left, 0.984711917 m up

left pusher arm
  is a           box 0.632455532 by 0.02 by 0.02 m, 0.04 kg
  at             -0.408251025 m along, 0 m to the left, 0.984711917 m up
  turns on       left cart spring hinge, about y, at left pusher pivot
  swings         from -18.434948823° to 0°
  spring         3.6 N·m/rad toward 0°
  damping        0.04 N·m·s/rad
  starts turned  -18.434948823°
  touches nothing
  colour         grey

left pusher outer tip
  is a         sphere 0.01 m radius, 0.005 kg
  at           -0.092023259 m along, 0.055 m to the left, 0.984711917 m up
  attached to  left pusher arm
  friction     0.68, spinning 0, rolling 0
  bounce       dead
  colour       grey

left pusher inner tip
  is a         sphere 0.01 m radius, 0.005 kg
  at           -0.092023259 m along, 0.055 m to the right, 0.984711917 m up
  attached to  left pusher arm
  friction     0.68, spinning 0, rolling 0
  bounce       dead
  colour       grey

right pusher pivot
  is a  point
  at    0.475521209 m along, 0 m to the left, 0.984711917 m up

right pusher arm
  is a           box 0.632455532 by 0.02 by 0.02 m, 0.04 kg
  at             0.159293443 m along, 0 m to the left, 0.984711917 m up
  turns on       right cart spring hinge, about y, at right pusher pivot
  swings         from 0° to 18.434948823°
  spring         3.6 N·m/rad toward 0°
  damping        0.04 N·m·s/rad
  starts turned  18.434948823°
  touches nothing
  colour         grey

right pusher outer tip
  is a         sphere 0.01 m radius, 0.005 kg
  at           -0.156934323 m along, 0.025 m to the left, 0.984711917 m up
  attached to  right pusher arm
  friction     0.68, spinning 0, rolling 0
  bounce       dead
  colour       grey

right pusher inner tip
  is a         sphere 0.01 m radius, 0.005 kg
  at           -0.156934323 m along, 0.025 m to the right, 0.984711917 m up
  attached to  right pusher arm
  friction     0.68, spinning 0, rolling 0
  bounce       dead
  colour       grey

-- The low surface edge and the bob's initial near surface
-- are separated by a 0.10 m horizontal gap.
-- This inverted rigid pendulum has a virtual 0.50 m rigid connection.
-- It starts upright and stationary; the ball initiates its swing.
pendulum pivot
  is a  point
  at    1.093112822 m along, 0 m to the left, -0.320 m up

pendulum1
  is a           sphere 0.10 m across, 0.35 kg
  at             1.093112822 m along, 0 m to the left, 0.180 m up
  turns on       pendulum hinge, about y, at pendulum pivot
  swings         from 0° to 40°
  damping        0.04 N·m·s/rad
  starts turned  0°
  friction       0.68, spinning 0, rolling 0
  bounce         dead
  colour         grey

-- Upright panel: width 0.42 m, height 0.32 m, thickness 0.04 m.
-- Contact begins just before the pendulum reaches its 40-degree stop.
-- Negative rotation about z is clockwise when viewed from above.
door1
  is a           box 0.04 by 0.42 by 0.32 m, 0.45 kg
  at             1.479506627 m along, 0 m to the left, 0.180 m up
  turns on       door hinge, about z, at its right side
  swings         from -70° to 0°
  damping        0.04 N·m·s/rad
  starts turned  0°
  friction       0.68, spinning 0, rolling 0
  bounce         dead
  colour         wood

block1
  is a      cube 0.12 m, 0.35 kg
  moves     freely
  rests     on floor, 1.940017931 m along, 0.085145392 m to the right
  friction  0.68, spinning 0, rolling 0
  bounce    dead
  colour    wood

expect
  cart1 touches ball1
  ball1 touches ramp1
  ball retainer reaches its upper stop
  ball1 touches pendulum1
  pendulum1 touches door1
  pendulum1 reaches its upper stop
  door1 reaches its lower stop
  door1 touches block1
