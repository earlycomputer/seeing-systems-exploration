<mujoco model="passive_chain_reaction">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="100" tolerance="1e-9"/>
  <size njmax="3000" nconmax="600"/>
  <visual>
    <global azimuth="100" elevation="-20"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
  </visual>

  <!-- solref damping ratio approximately corresponds to restitution 0.04.
       Sliding, torsional, and rolling friction coefficients are explicit.
       Spring assists supply energy without nonzero initial velocities. -->

  <worldbody>
    <light name="overhead_light" pos="-2 0 5" dir="0 0 -1"/>
    <camera name="overview" pos="-2.4 -7 3.4" xyaxes="1 0 0 0 0.4 0.9165"/>

    <geom name="floor" type="plane" size="8 5 0.1" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" solimp="0.95 0.99 0.001" rgba="0.25 0.28 0.31 1"/>

    <body name="ball1" pos="-0.30 0 1.02">
      <freejoint name="ball1_free"/>
      <geom name="ball1_sphere" type="sphere" size="0.05" mass="0.20" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" solimp="0.95 0.99 0.001" rgba="0.95 0.25 0.15 1"/>
    </body>

    <!-- Twelve capsule segments; minimum unobstructed diameter is 0.16 m. -->
    <body name="ring1" pos="-0.30 0 0.72">
      <geom name="ring1_01" type="capsule" fromto="0.093175 0 0 0.080692 0.0465875 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_02" type="capsule" fromto="0.080692 0.0465875 0 0.0465875 0.080692 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_03" type="capsule" fromto="0.0465875 0.080692 0 0 0.093175 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_04" type="capsule" fromto="0 0.093175 0 -0.0465875 0.080692 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_05" type="capsule" fromto="-0.0465875 0.080692 0 -0.080692 0.0465875 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_06" type="capsule" fromto="-0.080692 0.0465875 0 -0.093175 0 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_07" type="capsule" fromto="-0.093175 0 0 -0.080692 -0.0465875 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_08" type="capsule" fromto="-0.080692 -0.0465875 0 -0.0465875 -0.080692 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_09" type="capsule" fromto="-0.0465875 -0.080692 0 0 -0.093175 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_10" type="capsule" fromto="0 -0.093175 0 0.0465875 -0.080692 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_11" type="capsule" fromto="0.0465875 -0.080692 0 0.080692 -0.0465875 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring1_12" type="capsule" fromto="0.080692 -0.0465875 0 0.093175 0 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
    </body>

    <body name="lever1" pos="0 0 0.40">
      <joint name="lever1_hinge" type="hinge" axis="0 -1 0" damping="0.04" limited="true" range="0 45" solreflimit="0.004 0.716" solimplimit="0.99 0.999 0.001"/>
      <geom name="lever1_beam" type="box" size="0.30 0.05 0.02" mass="0.48" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.2 0.55 0.85 1"/>
      <geom name="lever1_striker" type="sphere" pos="0.29 0 0.015" size="0.015" mass="0.02" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.55 0.85 1"/>
    </body>

    <body name="lever1_support" pos="0 0 0.20">
      <geom name="lever1_support_column" type="box" size="0.035 0.07 0.20" contype="0" conaffinity="0" rgba="0.4 0.4 0.45 1"/>
    </body>

    <!-- The elevated cart has a rear pickup mast and a low domino striker.
         Their masses are included in the specified 0.50 kg cart mass. -->
    <body name="cart1" pos="0.16 0 0.70">
      <joint name="cart1_slide" type="slide" axis="-1 0 0" damping="0.20" limited="true" range="0 0.65"/>
      <geom name="cart1_chassis" type="box" size="0.11 0.09 0.05" mass="0.43" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.7 0.45 1"/>
      <geom name="cart1_pickup_mast" type="box" pos="0.11 0 -0.15" size="0.012 0.04 0.13" mass="0.04" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.7 0.45 1"/>
      <geom name="cart1_domino_striker" type="box" pos="-0.098 0 -0.20" size="0.012 0.07 0.035" mass="0.03" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.7 0.45 1"/>
    </body>

    <body name="domino1_platform" pos="-0.41 0 0.185">
      <geom name="domino1_platform_box" type="box" size="0.07 0.08 0.185" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.45 0.45 0.5 1"/>
    </body>

    <body name="domino1" pos="-0.41 0 0.49">
      <freejoint name="domino1_free"/>
      <geom name="domino1_box" type="box" size="0.04 0.02 0.12" mass="0.25" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.95 0.65 0.15 1"/>
    </body>

    <body name="ball2" pos="-0.590101 0 0.539005">
      <freejoint name="ball2_free"/>
      <geom name="ball2_sphere" type="sphere" size="0.05" mass="0.20" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.95 0.25 0.15 1"/>
    </body>

    <!-- The upper surface has length 1.00 m, width 0.30 m,
         inclination 20 degrees, and low-end height 0.15 m. -->
    <body name="ramp1" pos="-1.036006 0 0.302216" quat="0.984807753 0 -0.173648178 0">
      <geom name="ramp1_deck" type="box" size="0.50 0.15 0.02" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.55 0.38 0.2 1"/>
    </body>

    <body name="door1" pos="-1.632693 0.21 0.19">
      <joint name="door1_hinge" type="hinge" axis="0 0 -1" damping="0.04" limited="true" range="0 70" solreflimit="0.004 0.716" solimplimit="0.99 0.999 0.001"/>
      <geom name="door1_panel" type="box" pos="0 -0.21 0" size="0.02 0.21 0.16" mass="0.42" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.65 0.3 0.75 1"/>
      <geom name="door1_pendulum_latch" type="box" pos="-0.352307 0.10 -0.13" size="0.01 0.06 0.06" mass="0.03" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.65 0.3 0.75 1"/>
    </body>

    <!-- The door latch holds the preloaded pendulum against its initial stop.
         Opening the door withdraws the latch. The 38-degree pendulum stroke
         runs from a 19-degree right lean to a 19-degree left lean. -->
    <body name="pendulum1" pos="-2.102784 0.31 0.532759" euler="0 -19 0">
      <joint name="pendulum1_hinge" type="hinge" axis="0 1 0" damping="0.04" stiffness="15" springref="38" limited="true" range="0 38" solreflimit="0.004 0.716" solimplimit="0.99 0.999 0.001"/>
      <geom name="pendulum1_rod" type="capsule" fromto="0 0 0 0 0 -0.50" size="0.009" mass="0.08" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.3 0.65 0.8 1"/>
      <geom name="pendulum1_bob" type="sphere" pos="0 0 -0.50" size="0.035" mass="0.27" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.3 0.65 0.8 1"/>
    </body>

    <body name="block1" pos="-2.34 0.31 0.06">
      <freejoint name="block1_free"/>
      <geom name="block1_cube" type="box" size="0.06 0.06 0.06" mass="0.35" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.85 0.4 0.15 1"/>
    </body>

    <!-- The latch plate travels with cart2. After approximately 0.42 m,
         its trailing edge clears the seesaw's low latch lug. -->
    <body name="cart2" pos="-2.86 0.31 0.051">
      <joint name="cart2_slide" type="slide" axis="-1 0 0" damping="0.20" limited="true" range="0 0.54"/>
      <geom name="cart2_chassis" type="box" size="0.11 0.09 0.05" mass="0.42" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.7 0.45 1"/>
      <geom name="cart2_latch_plate" type="box" pos="-0.375 0 0.749" size="0.265 0.04 0.01" mass="0.04" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.7 0.45 1"/>
      <geom name="cart2_latch_column" type="capsule" fromto="-0.09 0.15 0 -0.09 0.15 0.729" size="0.008" mass="0.02" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.7 0.45 1"/>
      <geom name="cart2_latch_crossbar" type="capsule" fromto="-0.09 0.15 0.729 -0.09 0 0.729" size="0.008" mass="0.02" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.7 0.45 1"/>
    </body>

    <body name="seesaw1" pos="-3.715 0.31 0.90" quat="0 0 0 1">
      <joint name="seesaw1_hinge" type="hinge" axis="0 -1 0" damping="0.04" stiffness="8" springref="42" limited="true" range="0 42" solreflimit="0.004 0.716" solimplimit="0.99 0.999 0.001"/>
      <geom name="seesaw1_beam" type="box" size="0.325 0.05 0.02" mass="0.43" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.2 0.55 0.85 1"/>
      <geom name="seesaw1_latch_lug" type="box" pos="-0.325 0 -0.06" size="0.018 0.025 0.03" mass="0.03" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.55 0.85 1"/>
      <geom name="seesaw1_low_striker" type="capsule" fromto="-0.325 -0.075 -0.025 -0.325 -0.075 -0.84" size="0.012" mass="0.05" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.55 0.85 1"/>
      <geom name="seesaw1_striker_crossbar" type="capsule" fromto="-0.325 0 0 -0.325 -0.075 -0.025" size="0.012" mass="0.04" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.2 0.55 0.85 1"/>
    </body>

    <body name="seesaw1_support" pos="-3.715 0.31 0.45">
      <geom name="seesaw1_support_column" type="box" size="0.035 0.07 0.45" contype="0" conaffinity="0" rgba="0.4 0.4 0.45 1"/>
    </body>

    <body name="ball3" pos="-4.04 0.31 0.97">
      <freejoint name="ball3_free"/>
      <geom name="ball3_sphere" type="sphere" size="0.05" mass="0.20" contype="3" conaffinity="3" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.95 0.25 0.15 1"/>
    </body>

    <!-- Ball-only guides enforce a nearly vertical launch and return.
         Collision bit 2 lets the beam pass through the guide structure. -->
    <body name="ball3_vertical_guide" pos="-4.04 0.31 0">
      <geom name="ball3_guide_x_positive" type="capsule" fromto="0.064 0 0.43 0.064 0 3.0" size="0.005" contype="2" conaffinity="2" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.65 0.7 0.75 0.35"/>
      <geom name="ball3_guide_x_negative" type="capsule" fromto="-0.064 0 0.43 -0.064 0 3.0" size="0.005" contype="2" conaffinity="2" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.65 0.7 0.75 0.35"/>
      <geom name="ball3_guide_y_positive" type="capsule" fromto="0 0.064 0.43 0 0.064 3.0" size="0.005" contype="2" conaffinity="2" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.65 0.7 0.75 0.35"/>
      <geom name="ball3_guide_y_negative" type="capsule" fromto="0 -0.064 0.43 0 -0.064 3.0" size="0.005" contype="2" conaffinity="2" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.65 0.7 0.75 0.35"/>
    </body>

    <body name="ring2" pos="-4.04 0.31 0.65">
      <geom name="ring2_01" type="capsule" fromto="0.093175 0 0 0.080692 0.0465875 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_02" type="capsule" fromto="0.080692 0.0465875 0 0.0465875 0.080692 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_03" type="capsule" fromto="0.0465875 0.080692 0 0 0.093175 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_04" type="capsule" fromto="0 0.093175 0 -0.0465875 0.080692 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_05" type="capsule" fromto="-0.0465875 0.080692 0 -0.080692 0.0465875 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_06" type="capsule" fromto="-0.080692 0.0465875 0 -0.093175 0 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_07" type="capsule" fromto="-0.093175 0 0 -0.080692 -0.0465875 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_08" type="capsule" fromto="-0.080692 -0.0465875 0 -0.0465875 -0.080692 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_09" type="capsule" fromto="-0.0465875 -0.080692 0 0 -0.093175 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_10" type="capsule" fromto="0 -0.093175 0 0.0465875 -0.080692 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_11" type="capsule" fromto="0.0465875 -0.080692 0 0.080692 -0.0465875 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
      <geom name="ring2_12" type="capsule" fromto="0.080692 -0.0465875 0 0.093175 0 0" size="0.01" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.9 0.75 0.2 1"/>
    </body>

    <body name="domino2_platform" pos="-4.015 0.31 0.06">
      <geom name="domino2_platform_box" type="box" size="0.07 0.08 0.06" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.45 0.45 0.5 1"/>
    </body>

    <body name="domino2" pos="-4.015 0.31 0.24">
      <freejoint name="domino2_free"/>
      <geom name="domino2_box" type="box" size="0.04 0.02 0.12" mass="0.25" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.95 0.65 0.15 1"/>
    </body>

    <body name="flap1" pos="-4.195 0.31 0.67">
      <joint name="flap1_hinge" type="hinge" axis="0 1 0" damping="0.04" limited="true" range="0 60" solreflimit="0.004 0.716" solimplimit="0.99 0.999 0.001"/>
      <geom name="flap1_panel" type="box" pos="0 0 -0.19" size="0.02 0.09 0.19" mass="0.28" friction="0.72 0.005 0.001" solref="0.01 0.716" rgba="0.65 0.3 0.75 1"/>
    </body>

    <body name="shelf1" pos="-4.46 0.31 0.55">
      <geom name="shelf1_deck" type="box" size="0.15 0.125 0.02" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" rgba="0.55 0.38 0.2 1"/>
    </body>

    <body name="ball4" pos="-4.345 0.31 0.62">
      <freejoint name="ball4_free"/>
      <geom name="ball4_sphere" type="sphere" size="0.05" mass="0.20" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" solimp="0.95 0.99 0.001" rgba="0.95 0.25 0.15 1"/>
    </body>

    <!-- Inner footprint is 0.30 by 0.30 m. The bottom top is z=0.02;
         walls rise 0.20 m above it and have thickness 0.02 m.
         Shelf top z=0.57 is 0.55 m above the cup bottom. -->
    <body name="cup1" pos="-4.76 0.31 0">
      <geom name="cup1_bottom" type="box" pos="0 0 0.01" size="0.17 0.17 0.01" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" solimp="0.95 0.99 0.001" rgba="0.2 0.65 0.7 1"/>
      <geom name="cup1_wall_x_positive" type="box" pos="0.16 0 0.12" size="0.01 0.17 0.10" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" solimp="0.95 0.99 0.001" rgba="0.2 0.65 0.7 0.8"/>
      <geom name="cup1_wall_x_negative" type="box" pos="-0.16 0 0.12" size="0.01 0.17 0.10" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" solimp="0.95 0.99 0.001" rgba="0.2 0.65 0.7 0.8"/>
      <geom name="cup1_wall_y_positive" type="box" pos="0 0.16 0.12" size="0.15 0.01 0.10" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" solimp="0.95 0.99 0.001" rgba="0.2 0.65 0.7 0.8"/>
      <geom name="cup1_wall_y_negative" type="box" pos="0 -0.16 0.12" size="0.15 0.01 0.10" friction="0.72 0.005 0.001" condim="6" solref="0.01 0.716" solimp="0.95 0.99 0.001" rgba="0.2 0.65 0.7 0.8"/>
    </body>
  </worldbody>

  <!-- Omitted qpos uses the compiled initial configuration.
       Omitted qvel initializes every degree of freedom to zero. -->
  <keyframe>
    <key name="start" time="0"/>
  </keyframe>
</mujoco>
