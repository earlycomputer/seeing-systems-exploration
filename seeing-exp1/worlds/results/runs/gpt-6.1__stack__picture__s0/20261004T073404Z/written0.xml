<mujoco model="five_block_topple">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="100" tolerance="1e-10"/>
  <statistic center="0.2 0 0.45" extent="2.2"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.65 0.65 0.65" specular="0.15 0.15 0.15"/>
    <rgba haze="0.85 0.90 0.95 1"/>
  </visual>

  <worldbody>
    <light name="overhead" pos="0 -2 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="4 4 0.1" friction="0.75 0.005 0.001" solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.78 0.80 0.83 1"/>

    <body name="pusher" pos="-1 0 0.09">
      <joint name="push_slide" type="slide" axis="1 0 0" limited="true" range="0 1.6" damping="0" solreflimit="0.008 1"/>
      <geom name="pusher_geom" type="box" size="0.07 0.13 0.08" mass="2" friction="0.25 0.005 0.001" solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.18 0.20 0.24 1"/>
    </body>

    <body name="block1" pos="0 0 0.1">
      <freejoint name="block1_free"/>
      <geom name="block1_geom" type="box" size="0.1 0.1 0.1" mass="0.5" friction="0.35 0.005 0.001" solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.85 0.25 0.20 1"/>
    </body>

    <body name="block2" pos="0 0 0.3">
      <freejoint name="block2_free"/>
      <geom name="block2_geom" type="box" size="0.1 0.1 0.1" mass="0.5" friction="0.35 0.005 0.001" solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.95 0.55 0.15 1"/>
    </body>

    <body name="block3" pos="0 0 0.5">
      <freejoint name="block3_free"/>
      <geom name="block3_geom" type="box" size="0.1 0.1 0.1" mass="0.5" friction="0.35 0.005 0.001" solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.90 0.78 0.20 1"/>
    </body>

    <body name="block4" pos="0 0 0.7">
      <freejoint name="block4_free"/>
      <geom name="block4_geom" type="box" size="0.1 0.1 0.1" mass="0.5" friction="0.35 0.005 0.001" solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.25 0.65 0.40 1"/>
    </body>

    <body name="block5" pos="0 0 0.9">
      <freejoint name="block5_free"/>
      <geom name="block5_geom" type="box" size="0.1 0.1 0.1" mass="0.5" friction="0.35 0.005 0.001" solref="0.005 1" solimp="0.95 0.99 0.001" rgba="0.25 0.45 0.85 1"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="push_motor" joint="push_slide" kv="120" ctrllimited="true" ctrlrange="0 1.25" forcelimited="true" forcerange="-100 100"/>
  </actuator>

  <keyframe>
    <key name="start" ctrl="1.25"/>
  </keyframe>
</mujoco>
