      <geom name="rim_06" type="capsule" size="0.008" fromto="-0.16730 0.16730 0 -0.21859 0.09054 0" rgba="0.9 0.2 0.05 1"/>
      <geom name="rim_07" type="capsule" size="0.008" fromto="-0.21859 0.09054 0 -0.2366 0 0" rgba="0.9 0.2 0.05 1"/>
