      <geom name="cup_wall_10" type="box" pos="0 0.084853 -0.084853" euler="225 0 0" size="0.16 0.0243 0.004" rgba="0.22 0.48 0.52 1" condim="6" friction="0.6 0.003 0.001" solref="0.02 1" priority="1"/>
      <geom name="cup_wall_11" type="box" pos="0 0.110866 -0.045922" euler="247.5 0 0" size="0.16 0.0243 0.004" rgba="0.22 0.48 0.52 1" condim="6" friction="0.6 0.003 0.001" solref="0.02 1" priority="1"/>
      <geom name="cup_wall_12" type="box" pos="0 0.12 0" euler="270 0 0" size="0.16 0.0243 0.004" rgba="0.22 0.48 0.52 1" condim="6" friction="0.6 0.003 0.001" solref="0.02 1" priority="1"/>
      <geom name="cup_wall_13" type="box" pos="0 0.110866 0.045922" euler="292.5 0 0" size="0.16 0.0243 0.004" rgba="0.22 0.48 0.52 1" condim="6" friction="0.6 0.003 0.001" solref="0.02 1" priority="1"/>
      <geom name="cup_wall_14" type="box" pos="0 0.084853 0.084853" euler="315 0 0" size="0.16 0.0243 0.004" rgba="0.22 0.48 0.52 1" condim="6" friction="0.6 0.003 0.001" solref="0.02 1" priority="1"/>
      <geom name="cup_wall_15" type="box" pos="0 0.045922 0.110866" euler="337.5 0 0" size="0.16 0.0243 0.004" rgba="0.22 0.48 0.52 1" condim="6" friction="0.6 0.003 0.001" solref="0.02 1" priority="1"/>
      <geom name="cup_base" type="cylinder" pos="0.164 0 0" euler="0 90 0" size="0.124 0.004" rgba="0.18 0.39 0.43 1" condim="6" friction="0.6 0.003 0.001" solref="0.02 1" priority="1"/>
