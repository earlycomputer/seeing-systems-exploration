<mujoco model="five_block_stack">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="80" cone="elliptic"/>

  <visual>
    <global azimuth="135" elevation="-20"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
  </visual>

  <worldbody>
    <light name="overhead" pos="-2 -3 4" dir="0.4 0.5 -1" directional="true"/>
    <camera name="overview" pos="2.8 -3.5 2.0" xyaxes="0.781 0.625 0 -0.251 0.314 0.916"/>

    <geom name="floor" type="plane" pos="0 0 0" size="4 4 0.1" priority="1" friction="2.0 0.005 0.0001" solref="0.008 1" solimp="0.95 0.99 0.001" rgba="0.32 0.35 0.38 1"/>

    <body name="block1" pos="0 0 0.10">
      <freejoint name="block1_free"/>
      <geom name="block1_geom" type="box" size="0.05 0.09 0.10" mass="0.5" friction="1.0 0.005 0.0001" solref="0.008 1" solimp="0.95 0.99 0.001" rgba="0.85 0.25 0.18 1"/>
    </body>

    <body name="block2" pos="0 0 0.30">
      <freejoint name="block2_free"/>
      <geom name="block2_geom" type="box" size="0.05 0.09 0.10" mass="0.5" friction="1.0 0.005 0.0001" solref="0.008 1" solimp="0.95 0.99 0.001" rgba="0.95 0.55 0.16 1"/>
    </body>

    <body name="block3" pos="0 0 0.50">
      <freejoint name="block3_free"/>
      <geom name="block3_geom" type="box" size="0.05 0.09 0.10" mass="0.5" friction="1.0 0.005 0.0001" solref="0.008 1" solimp="0.95 0.99 0.001" rgba="0.90 0.78 0.20 1"/>
    </body>

    <body name="block4" pos="0 0 0.70">
      <freejoint name="block4_free"/>
      <geom name="block4_geom" type="box" size="0.05 0.09 0.10" mass="0.5" friction="1.0 0.005 0.0001" solref="0.008 1" solimp="0.95 0.99 0.001" rgba="0.25 0.65 0.40 1"/>
    </body>

    <body name="block5" pos="0 0 0.90">
      <freejoint name="block5_free"/>
      <geom name="block5_geom" type="box" size="0.05 0.09 0.10" mass="0.5" friction="1.0 0.005 0.0001" solref="0.008 1" solimp="0.95 0.99 0.001" rgba="0.25 0.45 0.85 1"/>
    </body>

    <!-- The initial gap lets the stack settle before the pusher arrives. -->
    <!-- Its striking face lies entirely below the initial block1/block2 interface. -->
    <body name="pusher" pos="-1.20 0 0.17">
      <joint name="pusher_slide" type="slide" axis="1 0 0" limited="true" range="0 1.50" damping="2" armature="0.01" solreflimit="0.005 1"/>
      <geom name="pusher_geom" type="box" size="0.04 0.075 0.025" mass="3" priority="2" friction="0.1 0.005 0.0001" solref="0.008 1" solimp="0.95 0.99 0.001" rgba="0.18 0.20 0.23 1"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="push" joint="pusher_slide" kv="250" ctrllimited="true" ctrlrange="0 2" forcelimited="true" forcerange="-80 80"/>
  </actuator>

  <keyframe>
    <key name="start" ctrl="1.5"/>
  </keyframe>
</mujoco>
