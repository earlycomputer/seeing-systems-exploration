<mujoco model="spring_catapult_into_bucket">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="100" tolerance="1e-10"/>
  <size njmax="1000" nconmax="200"/>

  <visual>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <worldbody>
    <light name="overhead" pos="1.5 -2 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="6 4 0.1" friction="0.8 0.005 0.0001" rgba="0.82 0.84 0.86 1"/>

    <body name="catapult_frame" pos="1 0 0">
      <geom name="catapult_base" type="box" pos="0 0 0.04" size="0.28 0.36 0.04" contype="0" conaffinity="0" rgba="0.30 0.20 0.12 1"/>
      <geom name="catapult_support_left" type="box" pos="0 -0.25 0.27" size="0.07 0.06 0.23" contype="0" conaffinity="0" rgba="0.45 0.30 0.16 1"/>
      <geom name="catapult_support_right" type="box" pos="0 0.25 0.27" size="0.07 0.06 0.23" contype="0" conaffinity="0" rgba="0.45 0.30 0.16 1"/>
      <geom name="catapult_axle" type="cylinder" pos="0 0 0.5" quat="0.70710678 0.70710678 0 0" size="0.045 0.34" contype="0" conaffinity="0" rgba="0.25 0.27 0.30 1"/>
    </body>

    <!-- The preloaded hinge spring raises the spoon; the upper stop releases the ball. -->
    <body name="catapult_arm" pos="1 0 0.5">
      <joint name="catapult_hinge" type="hinge" axis="0 1 0" range="0 0.65" stiffness="8.3" springref="1.3" damping="0.025" solreflimit="0.004 1" solimplimit="0.999 0.999 0.001"/>
      <geom name="catapult_beam" type="capsule" fromto="0 0 0 -1 0 0" size="0.025" mass="0.18" contype="0" conaffinity="0" rgba="0.60 0.39 0.18 1"/>
      <geom name="catapult_spoon_floor" type="box" pos="-1 0 0.015" size="0.13 0.13 0.015" mass="0.045" friction="0.1 0.001 0.0001" solref="0.006 1" solimp="0.95 0.99 0.001" rgba="0.65 0.44 0.22 1"/>
      <geom name="catapult_spoon_outer_wall" type="box" pos="-1.115 0 0.105" size="0.015 0.13 0.075" mass="0.016" friction="0.1 0.001 0.0001" solref="0.006 1" solimp="0.95 0.99 0.001" rgba="0.65 0.44 0.22 1"/>
      <geom name="catapult_spoon_inner_wall" type="box" pos="-0.885 0 0.105" size="0.015 0.13 0.075" mass="0.016" friction="0.1 0.001 0.0001" solref="0.006 1" solimp="0.95 0.99 0.001" rgba="0.65 0.44 0.22 1"/>
      <geom name="catapult_spoon_left_wall" type="box" pos="-1 -0.115 0.105" size="0.10 0.015 0.075" mass="0.012" friction="0.1 0.001 0.0001" solref="0.006 1" solimp="0.95 0.99 0.001" rgba="0.65 0.44 0.22 1"/>
      <geom name="catapult_spoon_right_wall" type="box" pos="-1 0.115 0.105" size="0.10 0.015 0.075" mass="0.012" friction="0.1 0.001 0.0001" solref="0.006 1" solimp="0.95 0.99 0.001" rgba="0.65 0.44 0.22 1"/>
    </body>

    <body name="ball" pos="0 0 0.6">
      <freejoint name="ball_free"/>
      <geom name="ball" type="sphere" size="0.07" mass="0.10" friction="0.2 0.001 0.0001" solref="0.006 1" solimp="0.95 0.99 0.001" rgba="0.95 0.18 0.08 1"/>
    </body>

    <!-- Its centre is exactly 3 m from the ball's initial centre. -->
    <!-- Overlapping primitive boxes form a closed, open-topped bucket wall. -->
    <body name="bucket" pos="3 0 0.6">
      <geom name="bucket_bottom" type="cylinder" pos="0 0 -0.57" size="0.56 0.03" friction="0.8 0.005 0.0001" solref="0.01 1" rgba="0.16 0.35 0.58 1"/>
      <geom name="bucket_wall_00" type="box" pos="0.51 0 0" euler="0 0 0" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_01" type="box" pos="0.471179 0.195169 0" euler="0 0 0.392699082" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_02" type="box" pos="0.360624 0.360624 0" euler="0 0 0.785398163" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_03" type="box" pos="0.195169 0.471179 0" euler="0 0 1.178097245" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_04" type="box" pos="0 0.51 0" euler="0 0 1.570796327" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_05" type="box" pos="-0.195169 0.471179 0" euler="0 0 1.963495408" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_06" type="box" pos="-0.360624 0.360624 0" euler="0 0 2.356194490" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_07" type="box" pos="-0.471179 0.195169 0" euler="0 0 2.748893572" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_08" type="box" pos="-0.51 0 0" euler="0 0 3.141592654" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_09" type="box" pos="-0.471179 -0.195169 0" euler="0 0 3.534291735" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_10" type="box" pos="-0.360624 -0.360624 0" euler="0 0 3.926990817" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_11" type="box" pos="-0.195169 -0.471179 0" euler="0 0 4.319689899" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_12" type="box" pos="0 -0.51 0" euler="0 0 4.712388980" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_13" type="box" pos="0.195169 -0.471179 0" euler="0 0 5.105088062" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_14" type="box" pos="0.360624 -0.360624 0" euler="0 0 5.497787144" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
      <geom name="bucket_wall_15" type="box" pos="0.471179 -0.195169 0" euler="0 0 5.890486225" size="0.03 0.105 0.57" friction="0.6 0.005 0.0001" solref="0.01 1" rgba="0.22 0.48 0.72 1"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="start" qpos="0 0 0 0.6 1 0 0 0" qvel="0 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
