          "text": "```xml\n<mujoco model=\"spring_catapult_into_bucket\">\n  <compiler angle=\"radian\" autolimits=\"true\"/>\n  <option timestep=\"0.002\" gravity=\"0 0 -9.81\" integrator=\"implicitfast\" solver=\"Newton\" iterations=\"100\" tolerance=\"1e-10\"/>\n  <size njmax=\"1000\" nconmax=\"200\"/>\n\n  <visual>\n    <global azimuth=\"135\" elevation=\"-25\"/>\n  </visual>\n\n  <worldbody>\n    <light name=\"overhead\" pos=\"1.5 -2 5\" dir=\"0 0 -1\" diffuse=\"0.8 0.8 0.8\"/>\n    <geom name=\"floor\" type=\"plane\" pos=\"0 0 0\" size=\"6 4 0.1\" friction=\"0.8 0.005 0.0001\" rgba=\"0.82 0.84 0.86 1\"/>\n\n    <body name=\"catapult_frame\" pos=\"1 0 0\">\n      <geom name=\"catapult_base\" type=\"box\" pos=\"0 0 0.04\" size=\"0.28 0.36 0.04\" contype=\"0\" conaffinity=\"0\" rgba=\"0.30 0.20 0.12 1\"/>\n      <geom name=\"catapult_support_left\" type=\"box\" pos=\"0 -0.25 0.27\" size=\"0.07 0.06 0.23\" contype=\"0\" conaffinity=\"0\" rgba=\"0.45 0.30 0.16 1\"/>\n      <geom name=\"catapult_support_right\" type=\"box\" pos=\"0 0.25 0.27\" size=\"0.07 0.06 0.23\" contype=\"0\" conaffinity=\"0\" rgba=\"0.45 0.30 0.16 1\"/>\n      <geom name=\"catapult_axle\" type=\"cylinder\" pos=\"0 0 0.5\" quat=\"0.70710678 0.70710678 0 0\" size=\"0.045 0.34\" contype=\"0\" conaffinity=\"0\" rgba=\"0.25 0.27 0.30 1\"/>\n    </body>\n\n    <!-- The preloaded hinge spring raises the spoon; the upper stop releases the ball. -->\n    <body name=\"catapult_arm\" pos=\"1 0 0.5\">\n      <joint name=\"catapult_hinge\" type=\"hinge\" axis=\"0 1 0\" range=\"0 0.65\" stiffness=\"8.3\" springref=\"1.3\" damping=\"0.025\" solreflimit=\"0.004 1\" solimplimit=\"0.999 0.999 0.001\"/>\n      <geom name=\"catapult_beam\" type=\"capsule\" fromto=\"0 0 0 -1 0 0\" size=\"0.025\" mass=\"0.18\" contype=\"0\" conaffinity=\"0\" rgba=\"0.60 0.39 0.18 1\"/>\n      <geom name=\"catapult_spoon_floor\" type=\"box\" pos=\"-1 0 0.015\" size=\"0.13 0.13 0.015\" mass=\"0.045\" friction=\"0.1 0.001 0.0001\" sol