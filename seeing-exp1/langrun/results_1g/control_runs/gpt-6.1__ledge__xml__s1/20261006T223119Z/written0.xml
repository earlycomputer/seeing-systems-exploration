<mujoco model="ball_rolls_into_bucket">
  <compiler angle="degree" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="80" cone="elliptic"/>
  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.65 0.65 0.65"/>
  </visual>

  <worldbody>
    <light name="overhead" pos="-0.3 -1 3" dir="0.1 0.2 -1"/>
    <camera name="overview" pos="0 -3 1.65" xyaxes="1 0 0 0 0.35 0.93675"/>

    <geom name="floor" type="plane" size="4 4 0.1" rgba="0.72 0.74 0.76 1" condim="6" friction="0.9 0.02 0.02" solref="0.01 1"/>

    <!-- The tabletop ends at x = 0 and its upper surface is z = 0.80. -->
    <body name="table" pos="0 0 0">
      <geom name="table_top" type="box" pos="-0.65 0 0.765" size="0.65 0.40 0.035" rgba="0.56 0.34 0.17 1" priority="2" condim="3" friction="0.8 0.005 0.0001" solref="0.01 1"/>
      <geom name="table_leg_back_left" type="box" pos="-1.20 -0.32 0.365" size="0.035 0.035 0.365" rgba="0.32 0.20 0.12 1"/>
      <geom name="table_leg_back_right" type="box" pos="-1.20 0.32 0.365" size="0.035 0.035 0.365" rgba="0.32 0.20 0.12 1"/>
      <geom name="table_leg_front_left" type="box" pos="-0.10 -0.32 0.365" size="0.035 0.035 0.365" rgba="0.32 0.20 0.12 1"/>
      <geom name="table_leg_front_right" type="box" pos="-0.10 0.32 0.365" size="0.035 0.035 0.365" rgba="0.32 0.20 0.12 1"/>
    </body>

    <!-- Open bucket, centered exactly 0.60 m beyond the table edge. -->
    <!-- Overlapping wall segments form a closed ring without a lid. -->
    <body name="bucket" pos="0.60 0 0">
      <geom name="bucket_bottom" type="cylinder" pos="0 0 0.03" size="0.27 0.03" rgba="0.12 0.36 0.65 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_00" type="box" pos="0.250000 0 0.20" euler="0 0 0" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_01" type="box" pos="0.230970 0.095671 0.20" euler="0 0 22.5" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_02" type="box" pos="0.176777 0.176777 0.20" euler="0 0 45" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_03" type="box" pos="0.095671 0.230970 0.20" euler="0 0 67.5" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_04" type="box" pos="0 0.250000 0.20" euler="0 0 90" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_05" type="box" pos="-0.095671 0.230970 0.20" euler="0 0 112.5" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_06" type="box" pos="-0.176777 0.176777 0.20" euler="0 0 135" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_07" type="box" pos="-0.230970 0.095671 0.20" euler="0 0 157.5" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_08" type="box" pos="-0.250000 0 0.20" euler="0 0 180" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_09" type="box" pos="-0.230970 -0.095671 0.20" euler="0 0 202.5" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_10" type="box" pos="-0.176777 -0.176777 0.20" euler="0 0 225" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_11" type="box" pos="-0.095671 -0.230970 0.20" euler="0 0 247.5" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_12" type="box" pos="0 -0.250000 0.20" euler="0 0 270" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_13" type="box" pos="0.095671 -0.230970 0.20" euler="0 0 292.5" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_14" type="box" pos="0.176777 -0.176777 0.20" euler="0 0 315" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
      <geom name="bucket_wall_15" type="box" pos="0.230970 -0.095671 0.20" euler="0 0 337.5" size="0.015 0.052 0.17" rgba="0.16 0.44 0.76 1" priority="1" condim="6" friction="1.0 0.02 0.02" solref="0.01 1"/>
    </body>

    <body name="ball" pos="-0.90 0 0.85">
      <freejoint name="ball_free"/>
      <geom name="ball" type="sphere" size="0.05" mass="0.10" rgba="0.95 0.23 0.08 1" condim="6" friction="0.8 0.01 0.001" solref="0.01 1"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- Initial rolling condition: vx = radius * omega_y = 1.50 m/s. -->
    <key name="start" qpos="-0.90 0 0.85 1 0 0 0" qvel="1.50 0 0 0 30 0"/>
  </keyframe>
</mujoco>
