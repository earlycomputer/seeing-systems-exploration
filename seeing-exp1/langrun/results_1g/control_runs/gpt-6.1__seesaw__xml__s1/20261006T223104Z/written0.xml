    <geom name="floor" type="plane" size="5 5 0.1" condim="6" friction="1.2 0.02 0.05" solref="0.008 1" solimp="0.95 0.99 0.001" rgba="0.65 0.68 0.72 1"/>

    <body name="fulcrum" pos="0 0 0">
