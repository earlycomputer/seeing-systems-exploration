      <geom name="cup_wall_60" type="box" pos="0.1425 0.246817 0.105" euler="0 0 60" size="0.015 0.079 0.105" rgba="0.18 0.62 0.43 1" condim="6" friction="0.8 0.006 0.008" priority="2" solref="0.015 1"/>
