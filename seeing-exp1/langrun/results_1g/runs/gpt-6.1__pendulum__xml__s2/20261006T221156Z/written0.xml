      <geom name="cup_wall_06" type="box" pos="-0.127279 0.127279 0.04" size="0.012 0.037 0.09" euler="0 0 2.356194" rgba="0.2 0.55 0.8 1" priority="1" condim="6" friction="0.9 0.01 0.018" solref="0.006 1"/>

